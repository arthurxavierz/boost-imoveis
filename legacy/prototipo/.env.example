# ============================================================
# MODELO DE VARIAVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para um novo chamado .env e preencha os valores.
# O arquivo .env nunca sobe para o GitHub (ja esta no .gitignore).
#
# As chaves que comecam com VITE_ ficam disponiveis no frontend.
# A chave que NAO comeca com VITE_ (a service_role) fica APENAS
# no servidor, dentro das Netlify Functions. Nunca a exponha no navegador.
# ============================================================

# --- Supabase (frontend) ---
# Pegue em: Supabase > seu projeto > Settings > API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# --- Supabase (servidor, usado nas Netlify Functions) ---
# A chave mestra. So no servidor. Nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta

# --- WhatsApp Cloud API (Fase 2, opcional por enquanto) ---
WHATSAPP_VERIFY_TOKEN=um-token-que-voce-inventa
WHATSAPP_ACCESS_TOKEN=token-da-meta
WHATSAPP_PHONE_NUMBER_ID=id-do-numero

# --- Assistente de IA (Fase 3, opcional por enquanto) ---
# Pegue em: console.anthropic.com
ANTHROPIC_API_KEY=sua-chave-anthropic
