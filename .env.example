# ============================================================
# BOOST IMOVEIS - MODELO DE VARIAVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para .env.local na raiz do repositorio e preencha.
# O .env.local NUNCA sobe para o GitHub (ja esta no .gitignore).
#
# Em producao, estas mesmas variaveis vao em:
#   Netlify > Site configuration > Environment variables
# Cadastre nos DOIS sites (site publico e app), com um detalhe:
# a SUPABASE_SERVICE_ROLE_KEY so faz sentido onde ha funcao de servidor.
#
# REGRA DE OURO
# Tudo que comeca com NEXT_PUBLIC_ vai para dentro do JavaScript que o
# visitante baixa. Nunca coloque segredo com esse prefixo.
# ============================================================

# --- Supabase (publico, pode ir ao navegador) ---
# Supabase > seu projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# --- Supabase (servidor, NUNCA no navegador) ---
# Chave mestra: ignora todas as regras de RLS.
# Se vazar, alguem tem acesso total ao banco. Trate como senha do cofre.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta
SUPABASE_URL=https://seu-projeto.supabase.co

# --- Enderecos dos dois dominios ---
NEXT_PUBLIC_SITE_URL=https://boostimoveis.com.br
NEXT_PUBLIC_APP_URL=https://app.boostimoveis.com.br

# --- Dados institucionais exibidos no site ---
# O CRECI e obrigatorio por lei em anuncio imobiliario.
NEXT_PUBLIC_CRECI=CRECI-MG 00000-J
NEXT_PUBLIC_TELEFONE=(34) 99911-0001
NEXT_PUBLIC_WHATSAPP=5534999110001
NEXT_PUBLIC_EMAIL=contato@boostimoveis.com.br

# --- Cloudflare Turnstile (opcional, recomendado) ---
# Protege o formulario publico contra robo. Sem a chave secreta abaixo,
# a validacao e simplesmente pulada e o formulario continua funcionando.
# Crie em: dash.cloudflare.com > Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- WhatsApp Cloud API (fase de integracoes) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=

# --- Assistente de IA (fase de IA) ---
# console.anthropic.com
ANTHROPIC_API_KEY=
